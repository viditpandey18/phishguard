# Copy to .env and adjust. All PG_* settings are documented in phishguard/config.py.

PG_ENVIRONMENT=dev                 # prod disables /docs and /openapi.json
PG_LOG_LEVEL=INFO
PG_LOG_JSON=true

# --- API security ---
PG_API_KEYS=                       # comma-separated; REQUIRED in prod (empty = no auth)
PG_RATE_LIMIT_PER_MINUTE=60
PG_RATE_LIMIT_BURST=20
PG_CORS_ORIGINS=                   # e.g. chrome-extension://<id>,http://localhost:8501
PG_TRUST_PROXY_HEADERS=false       # true only behind a reverse proxy you control

# --- limits ---
PG_MAX_TEXT_CHARS=20000
PG_MAX_EMAIL_BYTES=2000000
PG_MAX_REQUEST_BYTES=2500000

# --- decision thresholds (calibrated probability) ---
PG_THRESHOLD_SUSPICIOUS=0.40
PG_THRESHOLD_MALICIOUS=0.70

# --- models ---
PG_TEXT_MODEL=baseline             # baseline | transformer | none
# PG_TRANSFORMER_MODEL_DIR=phishguard/models/artifacts/transformer
# PG_ENSEMBLE_WEIGHTS_FILE=phishguard/models/artifacts/ensemble_weights.json

# --- privacy ---
PG_STORE_CONTENT=false             # never store raw messages

# --- external threat intel (PASSIVE: discloses URLs to these third parties) ---
PG_ENABLE_NETWORK_INTEL=false
PG_INTEL_TIMEOUT_S=3
# PG_OPENPHISH_FEED_FILE=data/raw/openphish/feed.txt   # local lookup, nothing leaves the host
GSB_API_KEY=
PHISHTANK_APP_KEY=
VT_API_KEY=

# --- ACTIVE probing (contacts suspect servers) - sandbox container only ---
PG_ENABLE_ACTIVE_PROBING=false
PG_SANDBOX_API_KEY=
